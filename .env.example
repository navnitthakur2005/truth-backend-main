# TruthLens — Environment Configuration Examples
# 
# Copy this file to `.env` and fill in your actual values.
# Never commit the actual `.env` file to version control.

# Flask configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret
DEBUG=True

# Database configuration
# Use SQLite for local development; override with PostgreSQL URL for production
DATABASE_URL=sqlite:///instance/truthlens.db

# Google Fact Check Tools API key (optional)
# Get a key from: https://developers.google.com/fact-check/tools/overview
# Required for evidence-based verification; if absent, server starts
# but verification reports "unverified" with provider unavailable notice.
GOOGLE_FACT_CHECK_API_KEY=

# Email configuration (optional)
# Configure if you want the forgot-password endpoint to send real emails.
# If not configured, the endpoint reports the limitation honestly.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True

# Frontend origin for CORS and session cookies
# Used for cookie SameSite settings and CORS configuration
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Model configuration
# Path to the serialized ML model artifacts from the reference repository
# Ensure model/fake_news_model.pkl and model/tfidf_vectorizer.pkl exist
MODEL_PATH=model

# Application secrets
# Rotate regularly; used for token signing and password hashing salting